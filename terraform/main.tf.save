terraform {
required
providers {
aws = {
source = "hashicorp/aws"
version = "~> 5.0"
}
}
}
provider "aws" {
region = var.aws
}
#--- VPC--
resource "aws
region
vpc" "main" {
cidr
block
enable
dns
= "10.0.0.0/16"
hostnames = true
enable
dns
support = true
tags = { Name = "project3-vpc" }
}
vpc
#--- Internet Gateway--
resource "aws
internet
id = aws
gateway" "gw" {
vpc.main.id
tags = { Name = "project3-igw" }
